{
  "manifest_version": 3,
  "name": "Zara Browser Bridge",
  "description": "A permission-controlled Chrome bridge for the Zara personal voice assistant.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "scripting", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "host_permissions": [],
  "action": {
    "default_title": "Zara Browser Bridge",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://voice-8ts.pages.dev/*",
        "https://*.voice-8ts.pages.dev/*"
      ],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
